[9.034362, "o", "\u001b[3m                                                          EdgeLens v0.1.0 — Doctor                                                          \u001b[0m\r\n┌───────────────┬──────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────┐\r\n│\u001b[2m \u001b[0m\u001b[2mBoard        \u001b[0m\u001b[2m \u001b[0m│ NVIDIA Jetson Nano Developer Kit\u0000                                                                                         │\r\n│\u001b[2m \u001b[0m\u001b[2mIs Jetson    \u001b[0m\u001b[2m \u001b[0m│ \u001b[32myes\u001b[0m                                                                                                                      │\r\n│\u001b[2m \u001b[0m\u001b[2mL4T / JetPack\u001b[0m\u001b[2m \u001b[0m│ R32 (release), REVISION: 7.6, GCID: 38171779, BOARD: t210ref, EABI: aarch64, DATE: Tue Nov  5 07:46:14 UTC 2024          │\r\n│\u001b[2m \u001b[0m\u001b[2mCUDA         \u001b[0m\u001b[2m \u001b[0m│ 10.2.460                                                                                                                 │\r\n│\u001b[2m \u001b[0m\u001b[2mTensorRT     \u001b[0m\u001b[2m \u001b[0m│ 8.2.1.8 \u001b[33m(system library via dpkg; `import tensorrt` not available in Python 3.8.0 — apt bindings target the system \u001b[0m      │\r\n│\u001b[2m               \u001b[0m│ \u001b[33mPython only)\u001b[0m                                                                                                             │\r\n│\u001b[2m \u001b[0m\u001b[2mORT providers\u001b[0m\u001b[2m \u001b[0m│ Tensorrt, CUDA, CPU                                                                                                      │\r\n│\u001b[2m \u001b[0m\u001b[2mPython       \u001b[0m\u001b[2m \u001b[0m│ 3.8.0                                                                                                                    │\r\n│\u001b[2m \u001b[0m\u001b[2mOS           \u001b[0m\u001b[2m \u001b[0m│ Linux-4.9.337-tegra-aarch64-with-glibc2.27                                                                               │\r\n└───────────────┴──────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────┘\r\n"]
[9.04632, "o", "\u001b[3m     AI / vision packages      \u001b[0m\r\n┏━━━━━━━━━━━━━┳━━━━━━━━━━━━━━━┓\r\n┃\u001b[1m \u001b[0m\u001b[1mPackage    \u001b[0m\u001b[1m \u001b[0m┃\u001b[1m \u001b[0m\u001b[1mVersion      \u001b[0m\u001b[1m \u001b[0m┃\r\n┡━━━━━━━━━━━━━╇━━━━━━━━━━━━━━━┩\r\n│ torch       │ \u001b[2mnot installed\u001b[0m │\r\n│ onnx        │ \u001b[2mnot installed\u001b[0m │\r\n│ onnxruntime │ 1.11.0        │\r\n│ numpy       │ 1.24.4        │\r\n│ cv2         │ \u001b[2mnot installed\u001b[0m │\r\n│ pycuda      │ \u001b[2mnot installed\u001b[0m │\r\n└─────────────┴───────────────┘\r\n"]
[9.330192, "o", "\u001b[3m                                          Telemetry sources                                           \u001b[0m\r\n┏━━━━━━━━━━━━━━━━━━━━━━━┳━━━━━━━━━━━━━━━━━━━━━━━━━━━━┳━━━━━━━━━━━━━━━━━━━━━━━━━━━┳━━━━━━━━━━━━━━━━━━━┓\r\n┃\u001b[1m \u001b[0m\u001b[1mSource               \u001b[0m\u001b[1m \u001b[0m┃\u001b[1m \u001b[0m\u001b[1mStatus                    \u001b[0m\u001b[1m \u001b[0m┃\u001b[1m \u001b[0m\u001b[1mValue                    \u001b[0m\u001b[1m \u001b[0m┃\u001b[1m \u001b[0m\u001b[1mRead cost        \u001b[0m\u001b[1m \u001b[0m┃\r\n┡━━━━━━━━━━━━━━━━━━━━━━━╇━━━━━━━━━━━━━━━━━━━━━━━━━━━━╇━━━━━━━━━━━━━━━━━━━━━━━━━━━╇━━━━━━━━━━━━━━━━━━━┩\r\n│ GPU load (sysfs)      │ \u001b[32mok\u001b[0m \u001b[2m/sys/devices/gpu.0/load\u001b[0m │ 0.0%                      │\u001b[2m \u001b[0m\u001b[2m0.163 ms         \u001b[0m\u001b[2m \u001b[0m│\r\n│ Power (INA3221 sysfs) │ \u001b[31mfound, root-only\u001b[0m           │ see fix below             │\u001b[2m \u001b[0m\u001b[2m0.005 ms         \u001b[0m\u001b[2m \u001b[0m│\r\n│ Thermal zones         │ \u001b[32mok\u001b[0m                         │ 6 zones, max 50.0 C       │\u001b[2m \u001b[0m\u001b[2m2.153 ms         \u001b[0m\u001b[2m \u001b[0m│\r\n│ tegrastats            │ \u001b[32mok\u001b[0m                         │ GPU 0.0% · no power rails │\u001b[2m \u001b[0m\u001b[2mfirst line 0.26 s\u001b[0m\u001b[2m \u001b[0m│\r\n└───────────────────────┴────────────────────────────┴───────────────────────────┴───────────────────┘\r\n"]
[9.335008, "o", "\u001b[33m╭─\u001b[0m\u001b[33m───────────────────────────────────────────────────────\u001b[0m\u001b[33m Power: permission needed \u001b[0m\u001b[33m───────────────────────────────────────────────────────\u001b[0m\u001b[33m─╮\u001b[0m\r\n\u001b[33m│\u001b[0m\u001b[33m \u001b[0m\u001b[33mThe board's power sensor (INA3221) exists but is readable by root only, so power and energy are not reported. Make it readable (until \u001b[0m\u001b[33m  \u001b[0m\u001b[33m \u001b[0m\u001b[33m│\u001b[0m\r\n\u001b[33m│\u001b[0m\u001b[33m \u001b[0m\u001b[33mthe next reboot):\u001b[0m\u001b[33m                                                                                                                       \u001b[0m\u001b[33m \u001b[0m\u001b[33m│\u001b[0m\r\n\u001b[33m│\u001b[0m\u001b[33m \u001b[0m\u001b[33m                                                                                                                                        \u001b[0m\u001b[33m \u001b[0m\u001b[33m│\u001b[0m\r\n\u001b[33m│\u001b[0m\u001b[33m \u001b[0m\u001b[33m  sudo chmod o+r /sys/bus/i2c/drivers/ina3221x/6-0040/iio:device0/rail_name_* \u001b[0m\u001b[33m                                                          \u001b[0m\u001b[33m \u001b[0m\u001b[33m│\u001b[0m\r\n\u001b[33m│\u001b[0m\u001b[33m \u001b[0m\u001b[33m/sys/bus/i2c/drivers/ina3221x/6-0040/iio:device0/in_power*_input\u001b[0m\u001b[33m                                                                        \u001b[0m\u001b[33m \u001b[0m\u001b[33m│\u001b[0m\r\n\u001b[33m│\u001b[0m\u001b[33m \u001b[0m\u001b[33m                                                                                                                                        \u001b[0m\u001b[33m \u001b[0m\u001b[33m│\u001b[0m\r\n\u001b[33m│\u001b[0m\u001b[33m \u001b[0m\u001b[33mOr run a single benchmark as root:  sudo $(which edgelens) benchmark ... (files it saves will then be owned by root).\u001b[0m\u001b[33m                   \u001b[0m\u001b[33m \u001b[0m\u001b[33m│\u001b[0m\r\n\u001b[33m╰──────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────╯\u001b[0m\r\n"]
