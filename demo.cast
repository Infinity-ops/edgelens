[51.498259, "o", "\u001b[3m           EdgeLens Benchmark (hardware mode, vision pack,            \u001b[0m\r\n\u001b[3monnxruntime:TensorrtExecutionProvider (tests/fixtures/small_cnn.onnx))\u001b[0m\r\n┏━━━━━━━━━━━━━┳━━━━━━━━━━━━━┳━━━━━━━━━━┳━━━━━━━┳━━━━━━━━━━━━━━━━━━━━━┓\r\n┃\u001b[1m \u001b[0m\u001b[1mStage      \u001b[0m\u001b[1m \u001b[0m┃\u001b[1m \u001b[0m\u001b[1mRole       \u001b[0m\u001b[1m \u001b[0m┃\u001b[1m \u001b[0m\u001b[1mMean    \u001b[0m\u001b[1m \u001b[0m┃\u001b[1m \u001b[0m\u001b[1mp99  \u001b[0m\u001b[1m \u001b[0m┃\u001b[1m \u001b[0m\u001b[1mShare              \u001b[0m\u001b[1m \u001b[0m┃\r\n┡━━━━━━━━━━━━━╇━━━━━━━━━━━━━╇━━━━━━━━━━╇━━━━━━━╇━━━━━━━━━━━━━━━━━━━━━┩\r\n│ capture     │\u001b[2m \u001b[0m\u001b[2minput      \u001b[0m\u001b[2m \u001b[0m│ 0.006 ms │\u001b[2m \u001b[0m\u001b[2m0.007\u001b[0m\u001b[2m \u001b[0m│ # 0.1%              │\r\n│ preprocess  │\u001b[2m \u001b[0m\u001b[2mpreprocess \u001b[0m\u001b[2m \u001b[0m│ 2.220 ms │\u001b[2m \u001b[0m\u001b[2m4.096\u001b[0m\u001b[2m \u001b[0m│ ######## 33.9%      │\r\n│ h2d_copy    │\u001b[2m \u001b[0m\u001b[2mtransfer   \u001b[0m\u001b[2m \u001b[0m│ 0.629 ms │\u001b[2m \u001b[0m\u001b[2m0.814\u001b[0m\u001b[2m \u001b[0m│ ## 9.6%             │\r\n│ inference   │\u001b[2m \u001b[0m\u001b[2minference  \u001b[0m\u001b[2m \u001b[0m│ 3.450 ms │\u001b[2m \u001b[0m\u001b[2m3.726\u001b[0m\u001b[2m \u001b[0m│ ############# 52.7% │\r\n│ d2h_copy    │\u001b[2m \u001b[0m\u001b[2mtransfer   \u001b[0m\u001b[2m \u001b[0m│ 0.177 ms │\u001b[2m \u001b[0m\u001b[2m0.266\u001b[0m\u001b[2m \u001b[0m│ # 2.7%              │\r\n│ postprocess │\u001b[2m \u001b[0m\u001b[2mpostprocess\u001b[0m\u001b[2m \u001b[0m│ 0.067 ms │\u001b[2m \u001b[0m\u001b[2m0.124\u001b[0m\u001b[2m \u001b[0m│ # 1.0%              │\r\n└─────────────┴─────────────┴──────────┴───────┴─────────────────────┘\r\n"]
